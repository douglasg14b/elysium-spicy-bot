{
    "components": {
        "parameters": {},
        "schemas": {
            "ErrorBody": {
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ],
                "type": "object"
            },
            "Guild": {
                "properties": {
                    "iconURL": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "id": {
                        "type": "string"
                    },
                    "memberCount": {
                        "type": "number"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "iconURL",
                    "memberCount"
                ],
                "type": "object"
            },
            "GuildChannel": {
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "parentName": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "type": {
                        "enum": [
                            "text",
                            "category"
                        ],
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "type",
                    "parentId",
                    "parentName"
                ],
                "type": "object"
            },
            "GuildRole": {
                "properties": {
                    "color": {
                        "type": "number"
                    },
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "position": {
                        "type": "number"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "color",
                    "position"
                ],
                "type": "object"
            },
            "GuildSettings": {
                "description": "Staff roles, as saved. `staffRoles` names the ids that still resolve to a role and can be shorter than `staffRoleIds`, since a deleted role stays saved: render from `staffRoleIds`, label from `staffRoles`.",
                "properties": {
                    "staffRoleIds": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "staffRoles": {
                        "items": {
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "id",
                                "name"
                            ],
                            "type": "object"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "staffRoleIds",
                    "staffRoles"
                ],
                "type": "object"
            },
            "GuildSettingsUpdate": {
                "properties": {
                    "staffRoleIds": {
                        "items": {
                            "minLength": 1,
                            "type": "string"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "staffRoleIds"
                ],
                "type": "object"
            },
            "WarningsConfig": {
                "properties": {
                    "modChannelId": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "modChannelName": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "modChannelId",
                    "modChannelName"
                ],
                "type": "object"
            },
            "WarningsConfigUpdate": {
                "properties": {
                    "modChannelId": {
                        "minLength": 1,
                        "type": "string"
                    }
                },
                "required": [
                    "modChannelId"
                ],
                "type": "object"
            }
        }
    },
    "info": {
        "title": "BrattyBot dashboard API",
        "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/api/guilds": {
            "get": {
                "operationId": "listGuilds",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "guilds": {
                                            "items": {
                                                "$ref": "#/components/schemas/Guild"
                                            },
                                            "type": "array"
                                        }
                                    },
                                    "required": [
                                        "guilds"
                                    ],
                                    "type": "object"
                                }
                            }
                        },
                        "description": "The manageable guilds."
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "No valid session."
                    }
                },
                "summary": "Guilds the bot is in that the signed-in user may manage",
                "tags": [
                    "guilds"
                ]
            }
        },
        "/api/guilds/{guildId}/channels": {
            "get": {
                "operationId": "getGuildChannels",
                "parameters": [
                    {
                        "in": "path",
                        "name": "guildId",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "channels": {
                                            "items": {
                                                "$ref": "#/components/schemas/GuildChannel"
                                            },
                                            "type": "array"
                                        }
                                    },
                                    "required": [
                                        "channels"
                                    ],
                                    "type": "object"
                                }
                            }
                        },
                        "description": "The channel directory."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The server id is missing."
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "No valid session."
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The signed-in user may not manage this server."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The bot is not in this server."
                    }
                },
                "summary": "The guild's text channels and categories",
                "tags": [
                    "guilds"
                ]
            }
        },
        "/api/guilds/{guildId}/config/warnings": {
            "get": {
                "operationId": "getWarningsConfig",
