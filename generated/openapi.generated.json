                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The bot is not in this server."
                    }
                },
                "summary": "The guild's assignable roles",
                "tags": [
                    "guilds"
                ]
            }
        },
        "/api/guilds/{guildId}/settings": {
            "get": {
                "operationId": "getGuildSettings",
                "parameters": [
