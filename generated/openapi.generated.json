                        },
                        "description": "No valid session."
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The signed-in user may not manage this server."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The bot is not in this server."
                    }
                },
                "summary": "The warnings mod-log channel",
                "tags": [
                    "guilds"
                ]
            },
            "put": {
                "operationId": "updateWarningsConfig",
                "parameters": [
                    {
                        "in": "path",
                        "name": "guildId",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/WarningsConfigUpdate"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WarningsConfig"
                                }
                            }
                        },
                        "description": "The warnings config as saved."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The body was refused, or the server id is missing."
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "No valid session."
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The signed-in user may not manage this server."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The bot is not in this server."
                    },
                    "415": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        },
                        "description": "The body was not sent as JSON."
                    }
                },
                "summary": "Set the warnings mod-log channel",
                "tags": [
                    "guilds"
                ]
            }
        },
        "/api/guilds/{guildId}/roles": {
            "get": {
                "operationId": "getGuildRoles",
