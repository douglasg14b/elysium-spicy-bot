{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@tsconfig/recommended/tsconfig.json",
    "display": "Default",
    // `packages/` are workspace packages with a tsconfig of their own (the dashboard SDK
    // is browser code and needs DOM types this one lacks); `generated/` is emitted output.
    "exclude": ["node_modules", "web", "dist", "packages", "generated"],
    "include": ["**/*.ts", "declarations.d.ts"],
    "compilerOptions": {
        "rootDir": ".",
        "baseUrl": ".",
        // Root tests import dashboard modules typed by the generated SDK. The root has no
        // dependency on the package and no DOM library for its fetch client, so it sees the
        // contract alone — the generated types and zod (`packages/web-sdk/src/contract.ts`).
        // Types only: at run time nothing under `src/` can resolve the package, so a file
        // there that needs a value imports it by relative path (`blockFieldRules.test.ts`).
        "paths": {
            "@brattybot/web-sdk": ["packages/web-sdk/src/contract.ts"]
        },
        "typeRoots": ["node_modules/@types", "src/types"],
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        // Type-checking only. The bot runs through `tsx` and the dashboard through
        // Vite, so nothing here ever consumes compiled output — but `rootDir` is the
        // repo root, so a bare `tsc` (an editor task, an agent, a stray invocation)
        // wrote a `.js` beside all 508 sources. Carrying the flag on the `build`
        // script alone only protected the one caller that remembered it.
        "noEmit": true,
        "noEmitOnError": false,
        "experimentalDecorators": true,
        "resolveJsonModule": true
    }
}
